<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <%= link_to "Home", root_path, class:"navbar-brand"  %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <%= link_to "Tweets", tweets_path, class:"nav-link"  %>
        </li>
        <li class="nav-item">
          <!-- The issue with using a tag and href is that we need to specify the exact path-->
          <!-- But with this link_to helper we can change the routes just in routes.rb and dont need to modify the application everywhere-->
                  
          <%= link_to "About", about_path, class:"nav-link"  %>
        </li>
        <li>
          <%= link_to "Twitter Accounts", twitter_accounts_path, class:"nav-link"  %>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 ">
          <% if Current.user %>
            <li class="nav-item">
              <%= link_to Current.user.email, edit_password_path, class:"nav-link" %>
            </li>
            
            <!-- link_to is just an anchor tag. Use it primarily for GET actions and navigation. -->
            <!-- button_to generates a form with a button. Prefer it for non-GET actions (POST, PATCH, DELETE) as it's more secure. -->
            <!-- button_to works well with Hotwire (HTML over the wire), enabling partial updates instead of full page reloads. -->

          <li class="nav-item">
            <%= button_to "Logout", logout_path, method: :delete, class:"btn btn-secondary" %>
          </li>
                
          <% else %>
          <li class="nav-item">
            <%= link_to "Login", sign_in_path,class:"nav-link"%>
          </li>
          <li class="nav-item">
            <%= link_to "Sign Up", sign_up_path,class:"nav-link"%>
          </li>
          <% end %>
     
      </ul>
    </div>
  </div>
</nav>

<br>