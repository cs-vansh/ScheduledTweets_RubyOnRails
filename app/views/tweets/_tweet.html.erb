<div class="mb-3 card card-body">

    <div class="me-4">
        <%= image_tag tweet.twitter_account.image, class:"rounded-circle" %>
        <%= link_to "@#{tweet.twitter_account.username}", "https://x.com/#{tweet.twitter_account.username}", target: :_blank %>
        : 
        <%= tweet.body %>
    </div>


    <% if tweet.published? %>
    <%= link_to "View Tweet", "https://x.com/#{tweet.twitter_account.username}/status/#{tweet.tweet_id}", target: :_blank %>
    <% else %>

        <div class="d-flex align-items-center gap-3">
            <h6 class="mb-0">Scheduled for <%= l tweet.publish_at, format: :long %> UTC</h6>

            <%= link_to "Edit Tweet", edit_tweet_path(tweet), class:"btn btn-info", style:"width: 200px; height: 40px;" %>
        </div>

    <% end %>
</div>