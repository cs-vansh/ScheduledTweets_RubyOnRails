
<div class="text-center">
    <h1>Welcome to Scheduled Tweets</h1>
</div> 

<div class="d-flex justify-content-center align-items-center min-vh-50 mt-4">
    <% if Current.user %>
        <div class="d-flex gap-3">
            <%= link_to "My Scheduled Tweets", tweets_path, class: "btn btn-primary" %>
            <%= button_to "Logout", logout_path, method: :delete, class:"btn btn-danger" %>
        </div>
    <% else %>
        <div class="d-flex gap-3">
            <%= link_to "Login", sign_in_path, class: "btn btn-primary" %>
            <%= link_to "Sign Up", sign_up_path, class: "btn btn-primary" %>
        </div>
    <% end %>
</div>