
<div class="d-flex align-items-center justify-content-between">
    <h1>Twitter Accounts</h1>

    <%= button_to "Connect a Twitter account", "/auth/twitter/", method: :post, class:"btn btn-primary"  %>
</div>

<br>


<% if @twitter_accounts.any? %>
    <h2>Linked Accounts</h2>
    <hr>
<% end %>

<% @twitter_accounts.each do |twitter_account| %>
<div class="d-flex align-items-center mb-4">
    <div class="me-4">
        <%= image_tag twitter_account.image, class:"rounded-circle" %>
        <%= link_to "@#{twitter_account.username}", "https://x.com/#{twitter_account.username}", target: :_blank %>
    </div>

    <%= button_to "Disconnect", twitter_account, method: :delete, class:"btn btn-danger" %>
</div>
<% end %>


